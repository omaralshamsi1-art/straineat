{
  "name": "straineat-backend",
  "version": "1.0.1",
  "private": true,
  "description": "StrainEat — AI meal photo → nutrition agent, energy balance, Apple Health / WHOOP sync",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^6.2.18",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
